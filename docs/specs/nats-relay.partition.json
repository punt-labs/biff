    {
      "name": "ClientAttach",
      "kind": "delta",
      "inputs": [
        {
          "name": "c",
          "type": "CLIENT",
          "constraints": [
            "c notin attached"
          ]
        }
      ],
      "stateVars": [
        "daemon",
        "connState",
        "attached",
        "holdsHandle"
      ],
      "branches": [
        {
          "id": 1,
          "description": "A client attaches to a running daemon whose relay is not closed",
          "condition": "daemon = daemonUp & connState /= closed & c notin attached"
        }
      ],
      "partitions": [
        {
          "id": 1,
          "class": "happy-path",
          "status": "accepted",
          "inputs": {
            "c": "c1"
          },
          "preState": {
            "daemon": "daemonUp",
            "connState": "disconnected",
            "attached": []
          },
          "notes": "attach to a disconnected relay causes no dial; outcome = attachOk",
          "branch": 1,
          "postState": {
            "attached": [
              "c1"
            ],
            "connState": "disconnected"
          }
        },
        {
          "id": 2,
          "class": "standard",
          "status": "accepted",
          "inputs": {
            "c": "c2"
          },
          "preState": {
            "daemon": "daemonUp",
            "connState": "connected",
            "attached": [
              "c1"
            ]
          },
          "notes": "second client shares the one connection; generation and subscriptions unchanged",
          "branch": 1,
          "postState": {
            "attached": [
              "c1",
              "c2"
            ],
            "connState": "connected"
          }
        },
        {
          "id": 3,
          "class": "standard",
          "status": "accepted",
          "inputs": {
            "c": "c1"
          },
          "preState": {
            "daemon": "daemonUp",
            "connState": "halfOpen",
            "attached": []
          },
          "notes": "attach is allowed in every non-closed transport state (reconnecting, halfOpen included)",
          "branch": 1,
          "postState": {
            "attached": [
              "c1"
            ],
            "connState": "halfOpen"
          }
        },
        {
          "id": 4,
          "class": "rejected",
          "status": "rejected",
          "inputs": {
            "c": "c1"
          },
          "preState": {
            "daemon": "daemonAbsent",
            "connState": "disconnected",
            "attached": []
          },
          "notes": "Precondition daemon = daemonUp fails; see ClientAttachRefused (notRunning)"
        },
        {
          "id": 5,
          "class": "rejected",
          "status": "rejected",
          "inputs": {
            "c": "c1"
          },
          "preState": {
            "daemon": "daemonUp",
            "connState": "closed",
            "attached": []
          },
          "notes": "Precondition connState /= closed fails; see ClientAttachRefused (relayClosed)"
        },
        {
          "id": 6,
          "class": "rejected",
          "status": "rejected",
          "inputs": {
            "c": "c1"
          },
          "preState": {
            "daemon": "daemonUp",
            "connState": "connected",
            "attached": [
              "c1"
            ]
          },
          "notes": "Precondition c notin attached fails: already attached"
        }
      ],
      "summary": {
        "total": 6,
        "accepted": 3,
        "rejected": 3,
        "pruned": 0
      }
