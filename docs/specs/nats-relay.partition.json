          "notes": "outcome = relayClosed; shutting-down daemon",
          "branch": 2,
          "postState": {
            "daemon": "daemonUp",
            "connState": "closed",
            "attached": []
          }
        },
        {
          "id": 3,
          "class": "rejected",
          "status": "rejected",
          "inputs": {
            "c": "c1"
          },
          "preState": {
            "daemon": "daemonUp",
            "connState": "connected",
            "attached": []
          },
          "notes": "Neither refusal condition holds: attach is accepted, not refused"
        }
      ],
      "summary": {
        "total": 3,
        "accepted": 2,
        "rejected": 1,
        "pruned": 0
      }
