          "inputs": {
            "c": "c1"
          },
          "preState": {
            "daemon": "daemonAbsent",
            "attached": []
          },
          "notes": "outcome = notRunning; nothing changes; the client never hangs",
          "branch": 1,
          "postState": {
            "daemon": "daemonAbsent",
            "attached": []
          }
        },
        {
          "id": 2,
          "class": "standard",
          "status": "accepted",
          "inputs": {
            "c": "c1"
          },
          "preState": {
            "daemon": "daemonUp",
            "connState": "closed",
